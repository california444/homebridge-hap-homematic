{
  "name": "homebridge-hap-homematic",
  "displayName": "HAP HomeMatic",
  "version": "0.1.0",
  "description": "Homebridge plugin for HomeMatic / HomematicIP devices on a CCU / OpenCCU, using XML-RPC only. Hard fork of matthiaseinig/Homebridge-Homematic-HAP (homebridge-homematic-hap); not affiliated with thkl/hap-homematic.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "california444"
  },
  "contributors": [
    "mattein (Homebridge-Homematic-HAP, upstream of this fork) <https://github.com/matthiaseinig>",
    "thkl (original hap-homematic and homebridge-homematic author) <https://github.com/thkl>"
  ],
  "keywords": [
    "homebridge-plugin",
    "homematic",
    "homematicip",
    "ccu",
    "openccu",
    "raspberrymatic",
    "xml-rpc"
  ],
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=24",
    "homebridge": ">=2.4.0"
  },
  "peerDependencies": {
    "homebridge": ">=2.4.0"
  },
  "files": [
    "dist/",
    "homebridge-ui/",
    "config.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ./node_modules/typescript/bin/tsc && npm run build:ui",
    "build:ui": "./node_modules/.bin/esbuild homebridge-ui/server.src.js --bundle --platform=node --format=esm --target=node24 --outfile=homebridge-ui/server.js --external:../dist/*",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.0.0",
    "homematic-xmlrpc": "^1.0.2",
    "iconv-lite": "^0.6.3",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/tar": "^6.1.13",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.1",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
