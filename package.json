{
  "name": "homebridge-hap-homematic",
  "version": "1.4.0-beta.2",
  "description": "Homebridge plugin for HomeMatic / HomematicIP devices on a CCU / OpenCCU, using XML-RPC only.",
  "keywords": [
    "ccu",
    "homebridge-plugin",
    "homematic",
    "homematicip",
    "openccu",
    "raspberrymatic",
    "supports-hap",
    "xml-rpc"
  ],
  "homepage": "https://github.com/california444/homebridge-hap-homematic#readme",
  "bugs": {
    "url": "https://github.com/california444/homebridge-hap-homematic/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "california444"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/california444/homebridge-hap-homematic.git"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/RSchlich"
  },
  "files": [
    "dist/",
    "homebridge-ui/",
    "config.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ./node_modules/typescript/bin/tsc && npm run build:ui",
    "build:ui": "esbuild homebridge-ui/server.src.js --bundle --platform=node --format=esm --target=node24 --outfile=homebridge-ui/server.js --external:../dist/*",
    "lint": "oxlint --max-warnings=0 && oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "prepublishOnly": "npm run lint && npm run test",
    "watch": "npm run build && npm link && nodemon",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.7",
    "homematic-xmlrpc": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.11",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rimraf": "^6.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "homebridge": ">=2.4.0",
    "node": ">=22"
  }
}
