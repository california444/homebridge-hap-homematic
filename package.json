{
  "name": "homebridge-hap-homematic",
  "version": "0.0.0-development",
  "description": "Homebridge plugin for HomeMatic / HomematicIP devices on a CCU / OpenCCU, using XML-RPC only.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "california444"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homematic",
    "homematicip",
    "ccu",
    "openccu",
    "raspberrymatic",
    "xml-rpc"
  ],
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22",
    "homebridge": ">=2.4.0"
  },
  "files": [
    "dist/",
    "homebridge-ui/",
    "config.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ./node_modules/typescript/bin/tsc && npm run build:ui",
    "build:ui": "esbuild homebridge-ui/server.src.js --bundle --platform=node --format=esm --target=node24 --outfile=homebridge-ui/server.js --external:../dist/*",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev",
    "prepublishOnly": "npm run lint && npm run test",
    "watch": "npm run build && npm link && nodemon",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.7",
    "homematic-xmlrpc": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.0"
  },
  "homepage": "https://github.com/california444/homebridge-hap-homematic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/california444/homebridge-hap-homematic.git"
  },
  "bugs": {
    "url": "https://github.com/california444/homebridge-hap-homematic/issues"
  }
}
