# Build output (generated by `npm run build`; install via `npm pack`)
/dist/
/homebridge-ui/server.js
*.tsbuildinfo

# Local planning notes and CCU dumps (contain real device serials)
/plan*.md
/plans/

# Dependencies
node_modules/

# Test coverage
coverage/
*.lcov

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env / secrets — defense in depth even though we don't use any
.env
.env.local
.env.*.local

# Local Homebridge dev sandbox
test/hbConfig/persist/
test/hbConfig/accessories/
test/hbConfig/.uix-secrets

# References (cloned reference repos used for analysis only — not part of this plugin)
references/
target/

# Package manager
.npm
.pnp.*

# Optional outputs we don't ship
*.tgz
*.tar.gz

# Never commit hap-homematic backups (they may contain device serials,
# variable names, room layouts, even pairing material) or any
# credential file the developer might have used during testing.
hap-homematic-backup*
ccu-credentials*
*.creds
.ccu-probe.*

# CCU mock: own dumps (real serials) and runtime state
tools/ccu-mock/catalog/local/
tools/ccu-mock/state.json

# CCU probe outputs (real device addresses)
tools/ccu-probe/out/
