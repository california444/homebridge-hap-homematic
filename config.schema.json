{
  "pluginAlias": "HapHomematic",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "customUi": true,
  "customUiPath": "./homebridge-ui",
  "headerDisplay": "**HomeMatic (BidCos-RF) / HomematicIP (HmIP-RF)** plugin for a CCU / OpenCCU, using XML-RPC only. Use the **custom UI** below to discover devices and map channels to HomeKit.",
  "footerDisplay": "Hard fork of [Homebridge-Homematic-HAP](https://github.com/matthiaseinig/Homebridge-Homematic-HAP), which builds on [thkl/hap-homematic](https://github.com/thkl/hap-homematic) and [thkl/homebridge-homematic](https://github.com/thkl/homebridge-homematic). Apache-2.0.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform name",
        "type": "string",
        "default": "HapHomematic",
        "required": true
      },
      "ccuIp": {
        "title": "CCU IP / hostname",
        "type": "string",
        "format": "hostname",
        "required": true,
        "placeholder": "192.168.1.10",
        "description": "Address of your CCU / OpenCCU / RaspberryMatic."
      },
      "interfaces": {
        "title": "CCU interfaces",
        "type": "object",
        "properties": {
          "bidcosRf": {
            "title": "BidCos-RF",
            "type": "boolean",
            "default": true
          },
          "hmIpRf": {
            "title": "HmIP-RF",
            "type": "boolean",
            "default": true
          }
        }
      },
      "interfacePorts": {
        "title": "XML-RPC port overrides",
        "type": "object",
        "description": "XML-RPC ports of the CCU interfaces. Defaults: BidCos-RF 2001, HmIP-RF 2010.",
        "properties": {
          "BidCos-RF": {
            "title": "BidCos-RF port",
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "placeholder": "2001"
          },
          "HmIP-RF": {
            "title": "HmIP-RF port",
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "placeholder": "2010"
          }
        }
      },
      "useTls": {
        "title": "Use TLS to talk to CCU",
        "type": "boolean",
        "default": false,
        "description": "Not supported yet for XML-RPC; ignored (a warning is logged)."
      },
      "eventServer": {
        "title": "Local event server",
        "type": "object",
        "properties": {
          "host": {
            "title": "Bind host",
            "type": "string",
            "default": "0.0.0.0",
            "description": "Address Homebridge advertises to the CCU as the callback URL. Leave 0.0.0.0 to auto-detect."
          },
          "port": {
            "title": "Port",
            "type": "integer",
            "default": 9875,
            "minimum": 1024,
            "maximum": 65535
          },
          "watchdogSeconds": {
            "title": "Watchdog (s)",
            "type": "integer",
            "default": 300,
            "minimum": 30,
            "maximum": 3600,
            "description": "Re-init the RPC subscription if no events arrive within this window."
          }
        }
      },
      "channels": {
        "title": "Exposed channels",
        "type": "array",
        "items": {
          "$ref": "#/definitions/channelMapping"
        },
        "default": []
      }
    },
    "definitions": {
      "channelMapping": {
        "type": "object",
        "properties": {
          "address": {
            "title": "Channel address",
            "type": "string"
          },
          "name": {
            "title": "Display name",
            "type": "string"
          },
          "service": {
            "title": "Service class",
            "type": "string"
          },
          "subtype": {
            "title": "Service variant",
            "type": "string"
          },
          "settings": {
            "title": "Service settings",
            "type": "object"
          }
        },
        "required": [
          "address",
          "service"
        ]
      }
    }
  }
}
